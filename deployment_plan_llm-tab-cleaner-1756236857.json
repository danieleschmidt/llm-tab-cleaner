    },
    "alert_rules": {
      "groups": [
        {
          "name": "llm-tab-cleaner-alerts",
          "rules": [
            {
              "alert": "HighErrorRate",
              "expr": "rate(http_requests_total{status=~'5..'}[5m]) > 0.1",
              "for": "5m",
              "labels": {
                "severity": "critical"
              },
              "annotations": {
                "summary": "High error rate detected"
              }
            }
          ]
        }
      ]
    },
    "monitoring_endpoints": {
      "prometheus": "http://prometheus:9090",
