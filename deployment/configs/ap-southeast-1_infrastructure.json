{
  "region": "ap-southeast-1",
  "compliance": "pdpa",
  "vpc_config": {
    "enable_nat_gateway": true,
    "enable_vpn": false,
    "subnet_configuration": "private_public"
  },
  "security_groups": {
    "app_sg": {
      "ingress": [
        {
          "port": 8080,
          "source": "load_balancer"
        }
      ],
      "egress": [
        {
          "port": "all",
          "destination": "0.0.0.0/0"
        }
      ]
    },
    "lb_sg": {
      "ingress": [
        {
          "port": 443,
          "source": "0.0.0.0/0"
        }
      ],
      "egress": [
        {
          "port": 8080,
          "destination": "app_sg"
        }
      ]
    }
  },
  "encryption": {
    "at_rest": true,
    "in_transit": true,
    "key_management": "regional_kms"
  }
}